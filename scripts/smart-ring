#!/bin/bash
set -euo pipefail
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_dir"
# Embed the Bluetooth purpose string in the macOS executable, outside the library.
swift build --product smart-ring \
  -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist \
  -Xlinker "$repo_dir/platforms/apple/Examples/CLI-Info.plist" >&2
bin_dir="$(swift build --show-bin-path)"
exec "$bin_dir/smart-ring" "$@"
